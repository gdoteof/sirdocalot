  "output": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Three open questions — DESIGN.md decision sheet</title>\n<style>\n  :root{\n    --ink:#1a1a1a; --dim:#5c5c5c; --line:#dcd8d0; --bg:#faf8f5;\n    --card:#fff; --accent:#8a3324; --open:#b45309; --openbg:#fef3c7;\n  }\n  *{box-sizing:border-box}\n  body{\n    margin:0; background:var(--bg); color:var(--ink);\n    font:16px/1.65 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Helvetica,Arial,sans-serif;\n  }\n  .wrap{max-width:820px; margin:0 auto; padding:48px 24px 96px}\n  header{border-bottom:2px solid var(--ink); padding-bottom:20px; margin-bottom:36px}\n  h1{font-size:1.85rem; line-height:1.25; margin:0 0 8px; letter-spacing:-.02em}\n  .sub{color:var(--dim); margin:0; font-size:.95rem}\n  .who{margin-top:14px; font-size:.9rem; color:var(--dim)}\n  .who b{color:var(--ink)}\n  h2{font-size:1.25rem; margin:0 0 4px; letter-spacing:-.01em}\n  h3{font-size:.8rem; text-transform:uppercase; letter-spacing:.09em; color:var(--dim); margin:26px 0 8px}\n  .item{background:var(--card); border:1px solid var(--line); border-radius:6px; padding:26px 28px; margin-bottom:28px}\n  .tag{display:inline-block; background:var(--openbg); color:var(--open); font-size:.68rem; font-weight:700;\n       letter-spacing:.12em; padding:3px 8px; border-radius:3px; vertical-align:3px; margin-right:10px}\n  .num{color:var(--accent); font-weight:700}\n  p{margin:0 0 12px}\n  .item p:last-of-type{margin-bottom:0}\n  blockquote{margin:16px 0; padding:12px 18px; border-left:3px solid var(--accent);\n             background:#fdf6f4; color:#3d2e2b; font-size:.94rem}\n  pre.code{background:#1f1d1b; color:#e8e2d8; padding:12px 16px; border-radius:4px;\n           overflow-x:auto; font-size:.82rem; margin:14px 0}\n  .stake{font-size:.92rem; color:var(--dim); border-top:1px dashed var(--line); margin-top:18px; padding-top:14px}\n  .stake b{color:var(--ink)}\n  fieldset{border:none; margin:0; padding:0}\n  .resp{border-top:1px solid var(--line); margin-top:22px; padding-top:18px}\n  .resp-head{font-weight:700; font-size:.95rem; margin-bottom:10px}\n  .opts label{display:block; padding:7px 10px; border:1px solid transparent; border-radius:4px; cursor:pointer; font-size:.94rem}\n  .opts label:hover{background:#f4f1ec}\n  .opts input{margin-right:9px}\n  textarea{width:100%; min-height:76px; margin-top:10px; padding:10px 12px; font:inherit; font-size:.92rem;\n           border:1px solid var(--line); border-radius:4px; background:#fdfcfa; resize:vertical}\n  textarea:focus,select:focus,input:focus{outline:2px solid var(--accent); outline-offset:1px}\n  .mini{font-size:.86rem; color:var(--dim); margin:12px 0 4px}\n  .side-by-side{display:grid; grid-template-columns:1fr 1fr; gap:24px}\n  @media(max-width:680px){.side-by-side{grid-template-columns:1fr}}\n  .actions{display:flex; gap:12px; flex-wrap:wrap; margin-top:8px}\n  button{font:inherit; font-weight:600; padding:11px 20px; border-radius:5px; cursor:pointer; border:1px solid var(--ink)}\n  .primary{background:var(--ink); color:#fff}\n  .ghost{background:#fff; color:var(--ink)}\n  #out{white-space:pre-wrap; background:#1f1d1b; color:#e8e2d8; padding:20px; border-radius:6px;\n       font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.8rem; margin-top:20px; display:none}\n  footer{margin-top:40px; font-size:.85rem; color:var(--dim); border-top:1px solid var(--line); padding-top:16px}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n\n<header>\n  <h1>Three open questions in <code>docs/DESIGN.md</code></h1>\n  <p class=\"sub\">The argument as it stands, and a position required from each maintainer on every open item.</p>\n  <p class=\"who\">Answers needed from: <b>Priya</b> and <b>Sam</b>. Nothing here is decided; the <span class=\"tag\">OPEN</span> markers in the doc are reproduced faithfully.</p>\n</header>\n\n<!-- ITEM 1 -->\n<section class=\"item\">\n  <h2><span class=\"num\">1.</span> The core bet: a schema, not a framework</h2>\n\n  <h3>The argument</h3>\n  <p>Generating bespoke HTML costs thousands of output tokens every time, and that generation — not context loading, not deploy latency — is where the current approach is slow and expensive. So the agent-facing surface is a <b>schema it emits against</b>, not a framework it programs against:</p>\n  <pre class=\"code\">{\"type\": \"decision-matrix\", \"options\": [...], \"criteria\": [...]}</pre>\n  <p>That is a 20–50× token reduction over an authored page, and it is the entire reason this service exists. Any design decision that pushes agents back toward writing markup has broken the bet.</p>\n  <blockquote><span class=\"tag\">OPEN</span> Worth confirming against two or three real past generations before committing. If the dominant cost turns out to be context loading rather than generation, the answer is a cached design doc, not this service.</blockquote>\n  <p class=\"stake\"><b>What's at stake:</b> if the cost model is wrong, the service has no reason to exist. The counter-position is that the 20–50× figure is self-evident enough to build on without measuring.</p>\n\n  <div class=\"side-by-side\">\n    <div class=\"resp\">\n      <div class=\"resp-head\">Priya — position</div>\n      <fieldset class=\"opts\">\n        <label><input type=\"radio\" name=\"q1_priya\" value=\"Measure first — confirm against 2–3 real past generations before committing\">Measure first: confirm against 2–3 real past generations before committing</label>\n        <label><input type=\"radio\" name=\"q1_priya\" value=\"Commit now — the bet is sound enough to build on unmeasured\">Commit now: the bet is sound enough to build on unmeasured</label>\n        <label><input type=\"radio\" name=\"q1_priya\" value=\"Reject — dominant cost is context loading; build a cached design doc instead\">Reject: the dominant cost is context loading — build a cached design doc instead</label>\n        <label><input type=\"radio\" name=\"q1_priya\" value=\"Other / needs discussion\">Other / needs discussion</label>\n      </fieldset>\n      <textarea name=\"q1_priya_why\" placeholder=\"Why — and if you chose 'measure first', which generations count as the test?\"></textarea>\n    </div>\n    <div class=\"resp\">\n      <div class=\"resp-head\">Sam — position</div>\n      <fieldset class=\"opts\">\n        <label><input type=\"radio\" name=\"q1_sam\" value=\"Measure first — confirm against 2–3 real past generations before committing\">Measure first: confirm against 2–3 real past generations before committing</label>\n        <label><input type=\"radio\" name=\"q1_sam\" value=\"Commit now — the bet is sound enough to build on unmeasured\">Commit now: the bet is sound enough to build on unmeasured</label>\n        <label><input type=\"radio\" name=\"q1_sam\" value=\"Reject — dominant cost is context loading; build a cached design doc instead\">Reject: the dominant cost is context loading — build a cached design doc instead</label>\n        <label><input type=\"radio\" name=\"q1_sam\" value=\"Other / needs discussion\">Other / needs discussion</label>\n      </fieldset>\n      <textarea name=\"q1_sam_why\" placeholder=\"Why — and if you chose 'measure first', which generations count as the test?\"></textarea>\n    </div>\n  </div>\n</section>\n\n<!-- ITEM 2 -->\n<section class=\"item\">\n  <h2><span class=\"num\">2.</span> The per-dev cluster problem <span class=\"tag\">OPEN</span></h2>\n\n  <h3>The argument</h3>\n  <p>Every dev runs their own independent single-node k3s cluster behind their own tunnel. So a participant link points at <i>that dev's box</i>. A stakeholder clicking it six hours later gets an answer only if that box is still up — and the box is also a NixOS host that gets rebuilt.</p>\n  <p>For a dev-phase tool this is probably tolerable: the boxes are always-on and the blast radius is one dev's briefs. It is <b>not</b> tolerable if links go to people outside the team, because a dead link to an external stakeholder is worse than never having sent one.</p>\n  <p>The cheap insurance, taken now: <b>never bake the host into a brief's identity.</b> A handle and a participant token identify a brief; the hostname serving it is deployment configuration. That costs nothing today and keeps \"move it to one shared deployment\" a config change rather than a migration.</p>\n  <p class=\"stake\"><b>What's at stake:</b> this is named as the one risk worth raising up front. The open part is whether \"tolerable for now, insured by indirection\" is the right posture, or whether the shared deployment is owed sooner.</p>\n\n  <div class=\"side-by-side\">\n    <div class=\"resp\">\n      <div class=\"resp-head\">Priya — position</div>\n      <fieldset class=\"opts\">\n        <label><input type=\"radio\" name=\"q2_priya\" value=\"Tolerable — per-dev clusters, internal links only, revisit later\">Tolerable: per-dev clusters, links stay internal, revisit later</label>\n        <label><input type=\"radio\" name=\"q2_priya\" value=\"Tolerable but gated — external links blocked until a shared deployment exists\">Tolerable but gated: block external links until a shared deployment exists</label>\n        <label><input type=\"radio\" name=\"q2_priya\" value=\"Move to one shared deployment now\">Move to one shared deployment now</label>\n        <label><input type=\"radio\" name=\"q2_priya\" value=\"Other / needs discussion\">Other / needs discussion</label>\n      </fieldset>\n      <p class=\"mini\">Is host-independent brief identity sufficient insurance?</p>\n      <fieldset class=\"opts\">\n        <label><input type=\"radio\" name=\"q2b_priya\" value=\"Sufficient\">Sufficient</label>\n        <label><input type=\"radio\" name=\"q2b_priya\" value=\"Necessary but not sufficient\">Necessary but not sufficient</label>\n        <label><input type=\"radio\" name=\"q2b_priya\" value=\"Unsure\">Unsure</label>\n      </fieldset>\n      <textarea name=\"q2_priya_why\" placeholder=\"Why — including what would flip you to 'shared deployment now'\"></textarea>\n    </div>\n    <div class=\"resp\">\n      <div class=\"resp-head\">Sam — position</div>\n      <fieldset class=\"opts\">\n        <label><input type=\"radio\" name=\"q2_sam\" value=\"Tolerable — per-dev clusters, internal links only, revisit later\">Tolerable: per-dev clusters, links stay internal, revisit later</label>\n        <label><input type=\"radio\" name=\"q2_sam\" value=\"Tolerable but gated — external links blocked until a shared deployment exists\">Tolerable but gated: block external links until a shared deployment exists</label>\n        <label><input type=\"radio\" name=\"q2_sam\" value=\"Move to one shared deployment now\">Move to one shared deployment now</label>\n        <label><input type=\"radio\" name=\"q2_sam\" value=\"Other / needs discussion\">Other / needs discussion</label>\n      </fieldset>\n      <p class=\"mini\">Is host-independent brief identity sufficient insurance?</p>\n      <fieldset class=\"opts\">\n        <label><input type=\"radio\" name=\"q2b_sam\" value=\"Sufficient\">Sufficient</label>\n        <label><input type=\"radio\" name=\"q2b_sam\" value=\"Necessary but not sufficient\">Necessary but not sufficient</label>\n        <label><input type=\"radio\" name=\"q2b_sam\" value=\"Unsure\">Unsure</label>\n      </fieldset>\n      <textarea name=\"q2_sam_why\" placeholder=\"Why — including what would flip you to 'shared deployment now'\"></textarea>\n    </div>\n  </div>\n</section>\n\n<!-- ITEM 3 -->\n<section class=\"item\">\n  <h2><span class=\"num\">3.</span> Agent-facing interface: MCP over the REST API</h2>\n\n  <h3>The argument</h3>\n  <p>The REST API is built — see <code>README.md</code> for the routes. It is bearer-authenticated and is what the participant-facing app uses too.</p>\n  <blockquote><span class=\"tag\">OPEN</span> An MCP server over the top, exposing <code>list_widgets</code>, <code>create_brief</code>, <code>await_responses</code> as tools. That is the idiomatic agent-facing surface and would remove the need for an agent to remember curl invocations. REST stays underneath either way, because an orchestrator resuming a session is not necessarily an agent.</blockquote>\n  <p class=\"stake\"><b>What's at stake:</b> only the timing and the scope. REST is not in question. The question is whether MCP is built now, deferred until REST has been exercised in anger, or skipped.</p>\n\n  <div class=\"side-by-side\">\n    <div class=\"resp\">\n      <div class=\"resp-head\">Priya — position</div>\n      <fieldset class=\"opts\">\n        <label><input type=\"radio\" name=\"q3_priya\" value=\"Build MCP now, all three tools\">Build MCP now — all three tools</label>\n        <label><input type=\"radio\" name=\"q3_priya\" value=\"Build a thin slice now (create_brief only), grow later\">Build a thin slice now (<code>create_brief</code> only), grow later</label>\n        <label><input type=\"radio\" name=\"q3_priya\" value=\"Defer until REST has been exercised in real use\">Defer until REST has been exercised in real use</label>\n        <label><input type=\"radio\" name=\"q3_priya\" value=\"Skip MCP — REST is enough\">Skip MCP — REST is enough</label>\n        <label><input type=\"radio\" name=\"q3_priya\" value=\"Other / needs discussion\">Other / needs discussion</label>\n      </fieldset>\n      <textarea name=\"q3_priya_why\" placeholder=\"Why — and any concern about await_responses and long-poll behaviour\"></textarea>\n    </div>\n    <div class=\"resp\">\n      <div class=\"resp-head\">Sam — position</div>\n      <fieldset class=\"opts\">\n        <label><input type=\"radio\" name=\"q3_sam\" value=\"Build MCP now, all three tools\">Build MCP now — all three tools</label>\n        <label><input type=\"radio\" name=\"q3_sam\" value=\"Build a thin slice now (create_brief only), grow later\">Build a thin slice now (<code>create_brief</code> only), grow later</label>\n        <label><input type=\"radio\" name=\"q3_sam\" value=\"Defer until REST has been exercised in real use\">Defer until REST has been exercised in real use</label>\n        <label><input type=\"radio\" name=\"q3_sam\" value=\"Skip MCP — REST is enough\">Skip MCP — REST is enough</label>\n        <label><input type=\"radio\" name=\"q3_sam\" value=\"Other / needs discussion\">Other / needs discussion</label>\n      </fieldset>\n      <textarea name=\"q3_sam_why\" placeholder=\"Why — and any concern about await_responses and long-poll behaviour\"></textarea>\n    </div>\n  </div>\n</section>\n\n<!-- CLOSE -->\n<section class=\"item\">\n  <h2>Anything the three questions miss</h2>\n  <div class=\"side-by-side\">\n    <div>\n      <div class=\"resp-head\" style=\"margin-bottom:10px\">Priya</div>\n      <textarea name=\"extra_priya\" placeholder=\"A fourth open item, a hidden assumption, a decision you think has already been made without being written down.\"></textarea>\n    </div>\n    <div>\n      <div class=\"resp-head\" style=\"margin-bottom:10px\">Sam</div>\n      <textarea name=\"extra_sam\" placeholder=\"A fourth open item, a hidden assumption, a decision you think has already been made without being written down.\"></textarea>\n    </div>\n  </div>\n\n  <h3>Record</h3>\n  <div class=\"actions\">\n    <button class=\"primary\" type=\"button\" onclick=\"build()\">Generate summary</button>\n    <button class=\"ghost\" type=\"button\" onclick=\"copyOut()\">Copy to clipboard</button>\n    <button class=\"ghost\" type=\"button\" onclick=\"download()\">Download .md</button>\n  </div>\n  <pre id=\"out\"></pre>\n</section>\n\n<footer>Source: <code>docs/DESIGN.md</code>, quoted verbatim. This page holds no state and sends nothing anywhere — generate the summary and paste it back into the repo or the thread.</footer>\n\n</div>\n\n<script>\nconst ITEMS = [\n  [\"1. The core bet: a schema, not a framework\", \"q1\"],\n  [\"2. The per-dev cluster problem\", \"q2\"],\n  [\"3. Agent-facing interface: MCP over REST\", \"q3\"]\n];\nconst PEOPLE = [\"priya\",\"sam\"];\nconst cap = s => s[0].toUpperCase()+s.slice(1);\nconst radio = n => { const e = document.querySelector(`input[name=\"${n}\"]:checked`); return e ? e.value : \"— no position recorded —\"; };\nconst text  = n => { const e = document.querySelector(`[name=\"${n}\"]`); return e && e.value.trim() ? e.value.trim() : \"—\"; };\n\nfunction markdown(){\n  let o = \"# DESIGN.md — open items: recorded positions\\n\\n_Date: \" +\n          new Date().toISOString().slice(0,10) + \"_\\n\\n\";\n  ITEMS.forEach(([title,key]) => {\n    o += \"## \" + title + \"\\n\\n\";\n    PEOPLE.forEach(p => {\n      o += \"**\" + cap(p) + \":** \" + radio(key+\"_\"+p) + \"\\n\\n\";\n      if (key === \"q2\") o += \"  - Host-independent identity as insurance: \" + radio(\"q2b_\"+p) + \"\\n\\n\";\n      o += \"> \" + text(key+\"_\"+p+\"_why\").replace(/\\n/g,\"\\n> \") + \"\\n\\n\";\n    });\n  });\n  o += \"## Not covered by the three questions\\n\\n\";\n  PEOPLE.forEach(p => { o += \"**\" + cap(p) + \":** \" + text(\"extra_\"+p) + \"\\n\\n\"; });\n  return o.trimEnd() + \"\\n\";\n}\nfunction build(){ const el = document.getElementById(\"out\"); el.textContent = markdown(); el.style.display = \"block\"; el.scrollIntoView({behavior:\"smooth\",block:\"nearest\"}); }\nfunction copyOut(){ build(); navigator.clipboard.writeText(markdown()).then(()=>alert(\"Summary copied.\")).catch(()=>alert(\"Copy failed — select the text below and copy manually.\")); }\nfunction download(){\n  build();\n  const b = new Blob([markdown()], {type:\"text/markdown\"});\n  const a = document.createElement(\"a\");\n  a.href = URL.createObjectURL(b);\n  a.download = \"design-open-items-positions.md\";\n  a.click(); URL.revokeObjectURL(a.href);\n}\n</script>\n</body>\n</html>"
}
